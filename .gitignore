dataset/images/
dataset/*.csv
dataset/*.tsv

# -------------------------
# Project-specific: training outputs
# -------------------------
# Generic training / logging dirs
results/
runs/
wandb/
lightning_logs/
logs/

# Multimodal connector checkpoints
OpenCLIP_Linear_Projection_Tinyllama/
OpenCLIP_Two_MLP_StarCoder2/

# Root-level checkpoints directory (external weights)
checkpoints/

# -------------------------
# Project-specific: model weights under configs
# -------------------------
# TinyLLaMA full checkpoint
configs/TinyLlama-1.1b/model.safetensors
configs/TinyLlama-1.1b/pytorch_model.bin

# StarCoder2 LoRA adapter
configs/StarCoder2/adapter_model.safetensors

# Optional training state files (not required for inference)
configs/**/optimizer.pt
configs/**/scheduler.pt
configs/**/rng_state_*.pth

# Any other large model weight files dropped under configs
configs/**/*.bin
configs/**/*.pt
configs/**/*.ckpt
configs/**/*.safetensors

