FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

# 避免 tzdata 安裝時進入互動模式
ENV DEBIAN_FRONTEND=noninteractive

# 安裝必要工具與 tzdata（避免卡住）
RUN apt-get update && apt-get install -y \
    tzdata \
    git \
    wget \
    curl \
    nano \
    unzip \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 安裝 PyTorch + Transformers + retrain 需要的 Python 套件
RUN pip install --upgrade pip && \
    pip install \
    torch torchvision torchaudio \
    transformers==4.36.2 accelerate==0.27.2 \
    pandas openpyxl datasets scikit-learn \
    sentencepiece protobuf matplotlib
   
RUN pip uninstall -y peft


# 複製 Omniverse Farm 所需腳本與工具
COPY thirdparty/omnicli /omnicli
COPY scripts/docker/run.sh /run.sh
RUN chmod +x /omnicli/omnicli && chmod +x /run.sh
RUN sed -i 's/\r$//' /run.sh

# 安裝必要工具（如果尚未有）
RUN apt-get update && apt-get install -y \
    util-linux \
    tree \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /src /results && chmod -R 777 /src /results